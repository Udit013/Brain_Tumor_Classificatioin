# Keep the Docker build context small and prevent local secrets/artifacts
# from ever being copied into an image layer.
.git/
.github/
.venv/
.venv-tools/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

data/
legacy/
results/
space/

*.ipynb

# Exclude docs, but NOT README.md — pyproject.toml declares
# `readme = "README.md"`, so `pip install -e .` fails without it present.
MODEL_CARD.md
PROJECT_DOCUMENTATION.md
fastflo_guide.md

# Secrets — must never end up inside an image layer.
kaggle.json
**/kaggle.json
.kaggle/
access_token
.env
.env.*
*.env
.claude/
CLAUDE.md

.DS_Store
knowledge_doc.md
